# Copy to .env.local and fill in your values.
# Server-only variables are never exposed to the browser.

# Public site URL (SEO: sitemap, Open Graph, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://leadloom.in

# Optional: show live verified-designer count when available (> 0)
# NEXT_PUBLIC_VERIFIED_DESIGNER_COUNT=

# SMTP (registration email delivery via Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=registrations@yourdomain.com
SMTP_PASSWORD=your-smtp-app-password
REGISTRATION_FROM_EMAIL=Website Registration <registrations@yourdomain.com>
REGISTRATION_TO_EMAIL=registrations@yourdomain.com

# Cloudflare Turnstile (bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Upstash Redis (required for production rate limiting)
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
