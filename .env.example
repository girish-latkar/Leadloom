# Copy to .env.local and fill in your values.
# These variables are server-only and are never exposed to the browser.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
# Gmail App Password (16 chars) — NOT your normal Gmail password.
# Create one at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification on the Google account first.
SMTP_PASS=xxxx xxxx xxxx xxxx
LEAD_NOTIFY_EMAIL=where-you-want-leads@yourdomain.com
